<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  package="com.sudoq.sudoq_usage">

    <!-- Lets the user grant "Usage access" in Android settings. It is a
         special permission: the user turns it on by hand, the app cannot
         request it with a popup. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets the app see which apps have a launcher icon, for the
         "Select apps" screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
